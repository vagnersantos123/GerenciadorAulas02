<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:GerenciadorAulas02.ViewModels"
             x:Class="GerenciadorAulas02.Views.AulasPage"
             x:Name="ThisPage"
             Title="Aulas">

    <ContentPage.BindingContext>
        <viewmodels:AulasViewModel />
    </ContentPage.BindingContext>

    <Grid Padding="20" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="15">

        <!-- Cabeçalho clicável -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" VerticalOptions="Center" Padding="5">
            <Label Text="▶"
                   FontSize="20"
                   TextColor="Black"
                   Rotation="{Binding MostrarCriacaoAulas, Converter={StaticResource BoolParaAnguloConverter}}" />
            <Label Grid.Column="1"
                   Text="Adicionar Aulas"
                   VerticalOptions="Center"
                   FontSize="16" />
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding AlternarCriacaoAulasCommand}" />
            </Grid.GestureRecognizers>
        </Grid>

        <!-- Parte oculta: criação de aulas -->
        <StackLayout Grid.Row="1"
                     IsVisible="{Binding MostrarCriacaoAulas}" 
                     Spacing="10" Padding="10" BackgroundColor="#f5f5f5">

            <Label Text="Matéria:" />
            <Picker ItemsSource="{Binding Materias}"
                    ItemDisplayBinding="{Binding Nome}"
                    SelectedItem="{Binding MateriaSelecionada}" />

            <Label Text="Quantidade de Aulas:" />
            <Entry Keyboard="Numeric"
                   Text="{Binding QuantidadeAulas}" />

            <Label Text="Intervalo de Dias:" />
            <Entry Keyboard="Numeric"
                   Text="{Binding IntervaloDias}" />

            <Label Text="Duração (minutos):" />
            <Entry Keyboard="Numeric"
                   Text="{Binding DuracaoMinutos}" />

            <Label Text="Data Inicial:" />
            <DatePicker Date="{Binding DataInicioAno}" />

            <Label Text="Data Final:" />
            <DatePicker Date="{Binding DataFimAno}" IsEnabled="False" />

            <Button Text="Adicionar Aula"
                    Command="{Binding AdicionarAulaCommand}" />

            <Button Text="Gerar Aulas em Lote"
                    Command="{Binding GerarAulasCommand}" />
        </StackLayout>

        <!-- Barra de Pesquisa -->
        <SearchBar Grid.Row="2"
                   Placeholder="Pesquisar aulas..."
                   Text="{Binding Pesquisa, Mode=TwoWay}" />

        <!-- Lista de Aulas rolável -->
        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Aulas}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="5" ColumnDefinitions="*,Auto">

                        <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                            <Label Text="{Binding DiaAulaFormatado}" 
                                   VerticalOptions="Center" 
                                   FontAttributes="Bold" 
                                   TextColor="DarkBlue" 
                                   FontSize="14"/>
                            <Label Text="{Binding Titulo}" 
                                   VerticalOptions="Center" 
                                   FontSize="16"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Column="1" Spacing="5">
                            <Button Text="Editar"
                                    Command="{Binding BindingContext.EditarAulaCommand, Source={x:Reference ThisPage}}"
                                    CommandParameter="{Binding .}" />
                            <Button Text="Excluir"
                                    Command="{Binding BindingContext.ExcluirAulaCommand, Source={x:Reference ThisPage}}"
                                    CommandParameter="{Binding .}" />
                            <Button Text="Alunos"
                                    Command="{Binding BindingContext.GerenciarAlunosCommand, Source={x:Reference ThisPage}}"
                                    CommandParameter="{Binding .}" />
                        </HorizontalStackLayout>

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
