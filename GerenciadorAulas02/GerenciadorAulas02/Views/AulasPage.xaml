<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:GerenciadorAulas02.ViewModels"
             x:Class="GerenciadorAulas02.Views.AulasPage"
             Title="Aulas">

    <ContentPage.BindingContext>
        <viewmodels:AulasViewModel />
    </ContentPage.BindingContext>

    <StackLayout Padding="20" Spacing="15">

        <!-- Seleção de Matéria -->
        <Label Text="Matéria:" />
        <Picker ItemsSource="{Binding Materias}"
                ItemDisplayBinding="{Binding Nome}"
                SelectedItem="{Binding MateriaSelecionada}" />

        <!-- Quantidade de Aulas -->
        <Label Text="Quantidade de Aulas:" />
        <Entry Keyboard="Numeric"
               Text="{Binding QuantidadeAulas}" />

        <!-- Intervalo entre Aulas -->
        <Label Text="Intervalo de Dias:" />
        <Entry Keyboard="Numeric"
               Text="{Binding IntervaloDias}" />

        <!-- Duração das Aulas -->
        <Label Text="Duração (minutos):" />
        <Entry Keyboard="Numeric"
               Text="{Binding DuracaoMinutos}" />

        <!-- Datas -->
        <Label Text="Data Inicial:" />
        <DatePicker Date="{Binding DataInicioAno}" />

        <Label Text="Data Final:" />
        <DatePicker Date="{Binding DataFimAno}" IsEnabled="False" />

        <!-- Botões -->
        <Button Text="Adicionar Aula"
                Command="{Binding AdicionarAulaCommand}" />

        <Button Text="Gerar Aulas em Lote"
                Command="{Binding GerarAulasCommand}" />

        <!-- Lista de Aulas -->
        <CollectionView ItemsSource="{Binding Aulas}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Orientation="Horizontal" Padding="5">
                        <Label Text="{Binding Titulo}" VerticalOptions="Center" />
                        <Button Text="Editar"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AulasViewModel}}, Path=EditarAulaCommand}"
                                CommandParameter="{Binding .}" />
                        <Button Text="Excluir"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AulasViewModel}}, Path=ExcluirAulaCommand}"
                                CommandParameter="{Binding .}" />
                        <Button Text="Alunos"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AulasViewModel}}, Path=GerenciarAlunosCommand}"
                                CommandParameter="{Binding .}" />
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </StackLayout>
</ContentPage>
