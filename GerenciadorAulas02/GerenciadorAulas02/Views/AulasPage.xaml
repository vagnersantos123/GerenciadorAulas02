<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:GerenciadorAulas02.ViewModels"
             x:Class="GerenciadorAulas02.Views.AulasPage"
             x:Name="ThisPage"
             Title="Minhas Aulas">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- =========================
                 Formulário de Geração
                 ========================= -->
            <Frame BorderColor="Gray" Padding="10">
                <VerticalStackLayout Spacing="8">

                    <Label Text="Gerar Aulas para Matéria"
                           FontAttributes="Bold"
                           FontSize="18" />

                    <!-- Seleção da matéria -->
                    <Picker Title="Selecione a Matéria"
                            ItemsSource="{Binding Materias}"
                            ItemDisplayBinding="{Binding Nome}"
                            SelectedItem="{Binding MateriaSelecionada}" />

                    <!-- Quantidade -->
                    <Entry Placeholder="Quantidade de aulas"
                           Keyboard="Numeric"
                           Text="{Binding QuantidadeAulas}" />

                    <!-- Data inicial -->
                    <DatePicker Date="{Binding DataInicial}" />

                    <!-- Intervalo -->
                    <Entry Placeholder="Intervalo em dias"
                           Keyboard="Numeric"
                           Text="{Binding IntervaloDias}" />

                    <!-- Duração -->
                    <Entry Placeholder="Duração (minutos)"
                           Keyboard="Numeric"
                           Text="{Binding DuracaoMinutos}" />

                    <!-- Botão gerar -->
                    <Button Text="Gerar Aulas"
                            Command="{Binding GerarAulasCommand}" />

                </VerticalStackLayout>
            </Frame>

            <!-- =========================
                 Lista de Aulas
                 ========================= -->
            <Label Text="Aulas cadastradas"
                   FontSize="18"
                   FontAttributes="Bold"
                   Margin="0,10,0,5" />

            <CollectionView ItemsSource="{Binding Aulas}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="Gray" Padding="10" Margin="5">
                            <StackLayout>
                                <Label Text="{Binding Resumo}"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding Descricao}"
                                       FontSize="14"
                                       TextColor="Gray" />

                                <HorizontalStackLayout Spacing="10">
                                    <Button Text="Editar"
                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.EditarAulaCommand}"
                                            CommandParameter="{Binding}" />

                                    <Button Text="Excluir"
                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ExcluirAulaCommand}"
                                            CommandParameter="{Binding}" />

                                    <Button Text="Gerenciar Alunos"
                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.GerenciarAlunosCommand}"
                                            CommandParameter="{Binding}" />
                                </HorizontalStackLayout>
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
