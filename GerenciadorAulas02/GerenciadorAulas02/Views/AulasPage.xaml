<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:GerenciadorAulas02.ViewModels"
             x:Class="GerenciadorAulas02.Views.AulasPage"
             x:Name="ThisPage"
             Title="Aulas">

    <!-- BindingContext -->
    <ContentPage.BindingContext>
        <viewmodels:AulasViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">

            <!-- ================= FORMULÁRIO DE GERAÇÃO ================= -->
            <Frame BorderColor="Gray" Padding="15" CornerRadius="10">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Gerar Aulas" FontSize="20" FontAttributes="Bold" />

                    <!-- Seleção da Matéria -->
                    <Picker Title="Selecione a matéria"
                            ItemsSource="{Binding Materias}"
                            ItemDisplayBinding="{Binding Nome}"
                            SelectedItem="{Binding MateriaSelecionada}" />

                    <!-- Quantidade de aulas -->
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Quantidade de aulas:" VerticalOptions="Center"/>
                        <Entry Text="{Binding QuantidadeAulas, Mode=TwoWay}" Keyboard="Numeric" WidthRequest="80"/>
                    </HorizontalStackLayout>

                    <!-- Intervalo de dias -->
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Intervalo entre aulas (dias):" VerticalOptions="Center"/>
                        <Entry Text="{Binding IntervaloDias, Mode=TwoWay}" Keyboard="Numeric" WidthRequest="80"/>
                    </HorizontalStackLayout>

                    <!-- Duração -->
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Duração (minutos):" VerticalOptions="Center"/>
                        <Entry Text="{Binding DuracaoMinutos, Mode=TwoWay}" Keyboard="Numeric" WidthRequest="80"/>
                    </HorizontalStackLayout>

                    <!-- Data inicial -->
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Data inicial:" VerticalOptions="Center"/>
                        <DatePicker Date="{Binding DataInicial, Mode=TwoWay}" />
                    </HorizontalStackLayout>

                    <!-- Botão gerar -->
                    <Button Text="Gerar Aulas"
                            Command="{Binding GerarAulasCommand}" />
                </VerticalStackLayout>
            </Frame>

            <!-- ================= LISTA DE AULAS ================= -->
            <Frame BorderColor="Gray" Padding="15" CornerRadius="10">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Aulas Cadastradas" FontSize="20" FontAttributes="Bold" />

                    <CollectionView ItemsSource="{Binding Aulas}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BorderColor="LightGray" Padding="10" Margin="4">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" VerticalOptions="Center">
                                        <!-- Título da aula -->
                                        <Label Text="{Binding Titulo}" Grid.Column="0" VerticalOptions="Center" />

                                        <!-- Editar -->
                                        <Button Text="Editar"
                                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.EditarAulaCommand}"
                                                CommandParameter="{Binding}"
                                                Grid.Column="1" />

                                        <!-- Gerenciar Alunos -->
                                        <Button Text="Alunos"
                                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.GerenciarAlunosCommand}"
                                                CommandParameter="{Binding}"
                                                Grid.Column="2" />

                                        <!-- Excluir -->
                                        <Button Text="Excluir"
                                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ExcluirAulaCommand}"
                                                CommandParameter="{Binding}"
                                                Grid.Column="3" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
