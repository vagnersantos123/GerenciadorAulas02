<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:GerenciadorAulas02.ViewModels"
             x:Class="GerenciadorAulas02.Views.AulasPage"
             x:Name="ThisPage"
             Title="Minhas Aulas">

    <VerticalStackLayout Padding="20" Spacing="15">

        <!-- 🔹 Picker para selecionar a matéria -->
        <Label Text="Selecione a matéria:" FontSize="16" />
        <Picker Title="Matéria"
                ItemsSource="{Binding Materias}"
                ItemDisplayBinding="{Binding Nome}"
                SelectedItem="{Binding MateriaSelecionada}" />

        <!-- Botão de adicionar aula -->
        <Button Text="Adicionar Aula" 
                Command="{Binding AdicionarAulaCommand}" />

        <!-- Lista de aulas -->
        <CollectionView ItemsSource="{Binding Aulas}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="Gray" Padding="10" Margin="5">
                        <StackLayout>
                            <Label Text="{Binding Resumo}" FontSize="16" FontAttributes="Bold" />
                            <Label Text="{Binding Descricao}" FontSize="14" TextColor="Gray"/>

                            <HorizontalStackLayout Spacing="10">
                                <Button Text="Editar"
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.EditarAulaCommand}"
                                        CommandParameter="{Binding}" />

                                <Button Text="Excluir"
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ExcluirAulaCommand}"
                                        CommandParameter="{Binding}" />

                                <Button Text="Gerenciar Alunos"
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.GerenciarAlunosCommand}"
                                        CommandParameter="{Binding}" />
                            </HorizontalStackLayout>
                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
