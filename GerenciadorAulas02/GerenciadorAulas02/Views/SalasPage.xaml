<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:GerenciadorAulas02.ViewModels"
             x:Class="GerenciadorAulas02.Views.SalasPage"
             Title="Salas de Aula">

    <ContentPage.BindingContext>
        <viewmodels:SalasViewModel />
    </ContentPage.BindingContext>

    <!-- Grid principal -->
    <Grid Padding="20" RowSpacing="15"
          RowDefinitions="Auto,Auto,Auto,*">

        <!-- Campos de Data -->
        <VerticalStackLayout Grid.Row="0" Spacing="5">
            <Label Text="Data de Início do Ano:" />
            <DatePicker Date="{Binding DataInicioAno}" />

            <Label Text="Data de Fim do Ano:" />
            <DatePicker Date="{Binding DataFimAno}" />
        </VerticalStackLayout>

        <!-- Nome da sala + botão -->
        <VerticalStackLayout Grid.Row="1" Spacing="10">
            <Entry Placeholder="Nome da sala"
                   Text="{Binding NomeSala}" />
            <Button Text="Adicionar Sala"
                    Command="{Binding AdicionarSalaCommand}" />
        </VerticalStackLayout>

        <!-- Lista de Salas -->
        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Salas}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,4" Padding="10" CornerRadius="8" HasShadow="True" BorderColor="LightGray">
                        <Grid Padding="5"
                          ColumnDefinitions="*,Auto,Auto"
                          VerticalOptions="Center">

                            <VerticalStackLayout>
                                <Label Text="{Binding Nome}" FontAttributes="Bold" />
                                <Label Text="{Binding DataInicioAnoLetivo, StringFormat='Início: {0:dd/MM/yyyy}'}" FontSize="12" />
                                <Label Text="{Binding DataFimAnoLetivo, StringFormat='Fim: {0:dd/MM/yyyy}'}" FontSize="12" />
                            </VerticalStackLayout>

                            <!-- Botão Excluir -->
                            <Button Grid.Column="1"
                                Text="Excluir"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SalasViewModel}}, Path=ExcluirSalaCommand}"
                                CommandParameter="{Binding .}"
                                Margin="5,0,0,0" />

                            <!-- Botão Entrar -->
                            <Button Grid.Column="2"
                                Text="Entrar"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SalasViewModel}}, Path=SelecionarSalaCommand}"
                                CommandParameter="{Binding .}"
                                Margin="5,0,0,0" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
