<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:GerenciadorAulas02.ViewModels"
             x:Class="GerenciadorAulas02.Views.SalasPage"
             x:Name="ThisPage"
             Title="Salas de Aula">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Formulário simples para adicionar uma sala -->
            <Frame BorderColor="Gray" Padding="10">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Adicionar Sala" FontAttributes="Bold" FontSize="18" />

                    <Entry Placeholder="Nome da Sala"
                           Text="{Binding NomeSala}" />

                    <Button Text="Adicionar Sala"
                            Command="{Binding AdicionarSalaCommand}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Lista de Salas -->
            <Label Text="Salas cadastradas"
                   FontSize="18"
                   FontAttributes="Bold"
                   Margin="0,10,0,5" />

            <CollectionView ItemsSource="{Binding Salas}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="Gray" Padding="10" Margin="5">
                            <StackLayout>
                                <Label Text="{Binding Nome}"
                                       FontSize="16"
                                       FontAttributes="Bold" />

                                <HorizontalStackLayout Spacing="10">
                                    <Button Text="Ver Aulas"
                                            Clicked="OnVerAulasClicked"
                                            CommandParameter="{Binding}" />

                                    <Button Text="Excluir"
                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ExcluirSalaCommand}"
                                            CommandParameter="{Binding}" />
                                </HorizontalStackLayout>
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
