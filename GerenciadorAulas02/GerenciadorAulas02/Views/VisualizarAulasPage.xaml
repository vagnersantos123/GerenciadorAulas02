<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GerenciadorAulas02.Views.VisualizarAulasPage"
             Title="{Binding Title}">

    <CollectionView ItemsSource="{Binding Aulas}" SelectionMode="Single"
                    SelectionChanged="OnAulaSelected">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Padding="10" Margin="5" BorderColor="LightGray" CornerRadius="10">
                    <StackLayout>
                        <Label Text="{Binding Titulo}" FontSize="18"/>
                        <Label Text="{Binding DiaAula, StringFormat='dd/MM/yyyy'}" FontSize="14" TextColor="Gray"/>
                        <Label Text="{Binding Duracao, StringFormat='Duração: {0:h\\:mm}'}" FontSize="14" TextColor="Gray"/>
                    </StackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
