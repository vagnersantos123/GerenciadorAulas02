<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GerenciadorAulas02.Views.HomePage"
             Title="Home">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Button 
            Text="Visualizar Salas" 
            Clicked="OnVisualizarSalasClicked"/>


        <Button Text="Gerenciar Salas"
            Clicked="OnGerenciarSalasClicked" />

        <Button Text="Gerenciar Alunos"
                Clicked="OnGerenciarAlunosClicked" />


        <Button Text="Configurações"
            Clicked="OnConfiguracoesClicked" />

        <Button Text="Sair"
            Clicked="OnSairClicked" />
    </VerticalStackLayout>

</ContentPage>
