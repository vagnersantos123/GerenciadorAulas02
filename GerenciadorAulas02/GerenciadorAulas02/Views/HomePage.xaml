<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GerenciadorAulas02.Views.HomePage"
             Title="Home">

    <VerticalStackLayout Padding="30" Spacing="15">
        <Label Text="Bem-vindo ao Gerenciador de Aulas!" 
               FontSize="24" 
               HorizontalOptions="Center" />

        <Button Text="Gerenciar Aulas" Clicked="OnGerenciarAulasClicked" />
        <Button Text="Gerenciar Alunos" Clicked="OnGerenciarAlunosClicked" />
        <Button Text="Gerenciar Salas" Clicked="OnGerenciarSalasClicked" />
        <Button Text="Config" Clicked="OnConfiguracoesClicked" />
        <Button Text="Sair" Clicked="OnSairClicked" />
        




    </VerticalStackLayout>
</ContentPage>
