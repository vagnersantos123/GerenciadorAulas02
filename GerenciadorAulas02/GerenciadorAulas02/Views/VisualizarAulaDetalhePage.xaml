<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:GerenciadorAulas02.Converters"
             x:Class="GerenciadorAulas02.Views.VisualizarAulaDetalhePage"
             Title="Detalhes da Aula">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:AulaFinalizadaTextConverter x:Key="FinalizadaToTextConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Seção principal: título e status -->
            <Grid ColumnDefinitions="*, Auto, *" RowDefinitions="Auto, Auto, Auto">

                <!-- Título -->
                <Label Text="{Binding Titulo}" FontSize="24" FontAttributes="Bold"
                       Grid.Row="0" Grid.ColumnSpan="3"
                       HorizontalOptions="StartAndExpand"/>

                <!-- Data -->
                <Label Text="{Binding DiaAula, StringFormat='Data: {0:dd/MM/yyyy}'}" 
                       FontSize="16"
                       Grid.Row="1" Grid.Column="0"/>

                <!-- Duração -->
                <Label Text="{Binding DuracaoFormatada}" 
                        FontSize="16"
                        Grid.Row="1" Grid.Column="1"/>



                <!-- Status -->
                <Label Text="{Binding Finalizada, Converter={StaticResource FinalizadaToTextConverter}}" 
                       FontSize="16" TextColor="Green" 
                       HorizontalOptions="End"
                       Grid.Row="1" Grid.Column="2"/>

                <!-- Horário de início -->
                <Label Text="{Binding HorarioInicio, StringFormat='Início: {0:hh\\:mm}'}"
                       FontSize="16"
                       Grid.Row="2" Grid.Column="0"/>

                <!-- Horário de fim -->
                <Label Text="{Binding HorarioFim, StringFormat='Fim: {0:hh\\:mm}'}"
                       FontSize="16"
                       Grid.Row="2" Grid.Column="1"/>

            </Grid>

            <!-- Seção descrição -->
            <Frame Padding="10" BackgroundColor="#f0f0f0" CornerRadius="5">
                <Label Text="{Binding Descricao}" FontSize="16"/>
            </Frame>

            <!-- Seção ações -->
            <VerticalStackLayout Spacing="10">
                <Button
                    Command="{Binding FinalizarAulaCommand}"
                    Text="{Binding Finalizada, Converter={StaticResource FinalizadaToTextConverter}}"
                    IsEnabled="{Binding Finalizada, Converter={StaticResource InverseBoolConverter}}" />
            </VerticalStackLayout>

            <!-- Futuras seções: fotos, comentários -->
            <VerticalStackLayout x:Name="FotosSection" Spacing="10">
                <!-- placeholder para fotos -->
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="ComentariosSection" Spacing="10">
                <!-- placeholder para comentários -->
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
