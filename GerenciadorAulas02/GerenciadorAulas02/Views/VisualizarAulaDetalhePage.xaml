<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GerenciadorAulas02.Views.VisualizarAulaDetalhePage"
             Title="Detalhes da Aula">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">
            <Label Text="{Binding Titulo}" FontSize="24" FontAttributes="Bold"/>
            <Label Text="{Binding DiaAula, StringFormat='Data: {0:dd/MM/yyyy}'}" FontSize="16"/>
            <Label Text="{Binding Duracao, StringFormat='Duração: {0:h\\:mm}'}" FontSize="16"/>
            <Label Text="{Binding Descricao}" FontSize="16"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
