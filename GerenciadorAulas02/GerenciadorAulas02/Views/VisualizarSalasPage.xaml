<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GerenciadorAulas02.ViewModels"
             x:Class="GerenciadorAulas02.Views.VisualizarSalasPage"
             Title="Salas">

   

    <ContentPage.Content>
        <CollectionView ItemsSource="{Binding Salas}" SelectionMode="Single" SelectionChanged="OnSalaSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="5" BorderColor="LightGray" CornerRadius="10">
                        <Label Text="{Binding Nome}" FontSize="18"/>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </ContentPage.Content>
</ContentPage>
