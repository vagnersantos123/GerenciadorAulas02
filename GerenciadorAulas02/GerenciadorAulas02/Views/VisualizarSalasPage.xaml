<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GerenciadorAulas02.ViewModels"
             x:Class="GerenciadorAulas02.Views.VisualizarSalasPage"
             Title="Salas">

    <CollectionView ItemsSource="{Binding Salas}"
                SelectionMode="Single"
                SelectionChanged="OnSalaSelected">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame BorderColor="LightGray"
                   CornerRadius="10"
                   Padding="10"
                   Margin="5">
                    <VerticalStackLayout>
                        <Label Text="{Binding Nome}" FontSize="20" FontAttributes="Bold"/>
                        <Label Text="{Binding QuantidadeAulas, StringFormat='Aulas: {0}'}" FontSize="14"/>
                    </VerticalStackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>



</ContentPage>

