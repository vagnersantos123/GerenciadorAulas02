<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GerenciadorAulas02"
             xmlns:converters="clr-namespace:GerenciadorAulas02.Converters"
             x:Class="GerenciadorAulas02.App">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Aqui adicionamos o conversor -->
            <converters:BoolParaAnguloConverter x:Key="BoolParaAnguloConverter" />

        </ResourceDictionary>
    </Application.Resources>
</Application>
